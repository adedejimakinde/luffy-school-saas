# Template for /etc/classnode/backup.env: where the database backups go, and
# the key that makes them readable. Created by `deploy/init-env.sh backup`
# only when you have the Backblaze B2 bucket and key to hand — while
# WALG_S3_PREFIX is set the database archives to B2 (deploy/postgres/
# entrypoint.sh), and a prefix that points nowhere makes it fail.
#
# WALG_LIBSODIUM_KEY is generated for you. Backups are encrypted with it and
# are noise without it: copy it to your password manager (see
# docs/first-day.md step 24) before you rely on a single backup.

# s3://<bucket name>/classnode
WALG_S3_PREFIX=CHANGE_ME
# The application key's ID and the key itself, limited to that one bucket.
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
# https://s3.<region>.backblazeb2.com, with the region of the bucket's endpoint.
AWS_ENDPOINT=CHANGE_ME
AWS_REGION=CHANGE_ME
WALG_LIBSODIUM_KEY=GENERATE
WALG_LIBSODIUM_KEY_TRANSFORM=hex
# Optional: Sentry's check-in URL for the `nightly-backup` monitor. Delete the
# line if you have none.
# BACKUP_HEARTBEAT_URL=
