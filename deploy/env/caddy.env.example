# Template for /etc/classnode/caddy.env: the two things Caddy needs and nothing
# else, because Caddy is the process facing the internet.
#
# CLOUDFLARE_API_TOKEN: the custom token from docs/first-day.md step 10 (Zone ▸
# DNS ▸ Edit and Zone ▸ Zone ▸ Read, for the one zone). Not the "Global API
# Key". Edit this file on the server; `deploy/init-env.sh --check` tells you
# whether it still has a placeholder in it without printing a value.
CLOUDFLARE_API_TOKEN=CHANGE_ME
# An address you read: Let's Encrypt writes here before a certificate expires.
ACME_EMAIL=CHANGE_ME
