# Template for /etc/classnode/secrets.env. `deploy/init-env.sh` copies it there
# (never over a file that exists) and fills every GENERATE with a random value
# that is written to the file and printed nowhere. You edit the file ON THE
# SERVER; this template holds no secret and a real value never belongs here.
#
# Read by the web, worker and db containers (deploy/compose.yml). Not by Caddy.
# docs/deployment.md, "Configuration and secrets", says what else may go here.

DJANGO_SECRET_KEY=GENERATE
POSTGRES_PASSWORD=GENERATE

# Never add DEMO_SERVER=1 to a server that holds real schools: it is the demo
# server's switch (docs/demo-server.md).

# Added later, when each exists (see docs/deployment.md; none is needed on day one):
# SENTRY_DSN=
# EMAIL_HOST=
# EMAIL_PORT=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# MESSAGING_EMAIL_PROVIDER=messaging.smtp.SmtpProvider
