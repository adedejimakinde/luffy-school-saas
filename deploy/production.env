# Production configuration that is NOT secret. Committed, so that what a
# deployment runs with is reviewable; secrets live only on the server, in
# ${CLASSNODE_ETC:-/etc/classnode}/secrets.env (see docs/deployment.md), and
# never here.
#
# The platform's parent domain, named once. Everything that must agree with it
# is derived from it: the session cookie's domain, the allowed hosts and the
# default From address (settings.py), and the certificate and site addresses
# (deploy/caddy/Caddyfile). classnode.africa is the planned value; nothing is
# registered yet.
PLATFORM_DOMAIN=classnode.africa

# Caddy terminates TLS and speaks plain HTTP to gunicorn. This turns on the
# proxy header, the HTTPS redirect and HSTS together — settings.py says why they
# are one switch.
TLS_TERMINATED_BY_PROXY=1
SECURE_HSTS_SECONDS=86400

# Exactly one proxy — Caddy — writes X-Forwarded-For, and it overwrites what
# the client sent rather than appending to it. One is the only safe number:
# zero would count every client as Caddy's address, two would believe a hop the
# client invented. accounts/throttling.py.
TRUSTED_PROXY_COUNT=1

# The compose services, by name. The password is in secrets.env.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=classnode
POSTGRES_USER=classnode
CELERY_BROKER_URL=redis://redis:6379/0

TIME_ZONE=Africa/Lagos
LOG_LEVEL=INFO
