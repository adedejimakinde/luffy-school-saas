# Production configuration that is NOT secret. Committed, so that what a
# deployment runs with is reviewable; secrets live only on the server, in
# ${CLASSNODE_ETC:-/etc/classnode}/secrets.env (see docs/deployment.md), and
# never here.
#
# The platform's parent domain, named once. Everything that must agree with it
# is derived from it: the session cookie's domain, the allowed hosts and the
# default From address (settings.py), and the certificate and site addresses
# (deploy/caddy/Caddyfile), and the health check in deploy/deploy.sh.
# classnode.co is the real domain.
PLATFORM_DOMAIN=classnode.co

# Caddy terminates TLS and speaks plain HTTP to gunicorn. This turns on the
# proxy header, the HTTPS redirect and HSTS together — settings.py says why they
# are one switch.
TLS_TERMINATED_BY_PROXY=1
SECURE_HSTS_SECONDS=86400

# Exactly one proxy — Caddy — writes X-Forwarded-For, and it overwrites what
# the client sent rather than appending to it. One is the only safe number:
# zero would count every client as Caddy's address, two would believe a hop the
# client invented. accounts/throttling.py.
TRUSTED_PROXY_COUNT=1

# The compose services, by name. The password is in secrets.env.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=classnode
POSTGRES_USER=classnode
CELERY_BROKER_URL=redis://redis:6379/0
# Rendered pages of schools' public websites (settings.py, "Caches"): the
# same Redis, its own database, so the broker's keys and these never meet.
SITE_CACHE_URL=redis://redis:6379/1

TIME_ZONE=Africa/Lagos
LOG_LEVEL=INFO

# Paystack (test mode only, docs/paystack.md). The secret key, sk_test_..., is a
# secret and belongs in secrets.env as PAYSTACK_SECRET_KEY; a sk_live_ key is refused.
# Paystack signs webhooks with that same secret key, so there is NO separate
# webhook secret and nothing else to set: the webhook is verified with
# PAYSTACK_SECRET_KEY itself (a key that is not sk_test_ refuses every webhook).

# "Coming soon" labels on the pricing page (docs/website.md). Each is on until
# its feature ships: set it to 0 here, deploy, and the label goes.
# COMING_SOON_SCHOOL_WEBSITE=0
# COMING_SOON_CBT_SCHOOL_TESTS=0
# COMING_SOON_CBT_UTME_PRACTICE=0
# COMING_SOON_CBT_WASSCE_PRACTICE=0
# COMING_SOON_CUSTOM_DOMAIN=0
# COMING_SOON_SENDER_DOMAIN=0

# Classnode's phone line and public profiles, named in the public site's
# structured data (docs/website.md) when set and left out when not. Each profile
# is a full https:// address.
# SITE_PHONE=
# SITE_LINKEDIN_URL=
# SITE_GOOGLE_BUSINESS_URL=

# Uploaded files (`files`, docs/school-sites.md §9.1): on the data volume at
# /srv/classnode/media, mounted here in web, worker and media, and read-only in
# Caddy, which sends each file once Django has said who may have it.
FILES_ROOT=/srv/media
FILES_X_ACCEL=1
