# Kept out of the production image: history, development tooling, and anything
# built locally that the image builds for itself.
.git
.github
.devcontainer
**/__pycache__
**/*.pyc
staticfiles
node_modules
docs/claude-memory
deploy
# ...except the media backup script, which runs inside the app image as the
# `media-backup` service (deploy/compose.yml) and calls manage.py for alerts.
!deploy/media-backup.sh
# Anything a developer's checkout can hold that an image must not: a local
# environment file (secrets), a Redis snapshot (queued task arguments), a
# SQLite file, and the screenshots the layout tests write.
.env
.env.*
*.rdb
*.sqlite3
screens
